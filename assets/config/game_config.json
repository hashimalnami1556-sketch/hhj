        "experience_gain": 1.0,
        "enemy_health": 1.0
      },
      "hard": {
        "damage_received": 1.3,
        "experience_gain": 1.5,
        "enemy_health": 1.3
      },
      "legendary": {
        "damage_received": 2.0,
        "experience_gain": 2.5,
        "enemy_health": 2.0
      }
